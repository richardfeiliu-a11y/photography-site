---
/*
 * src/pages/404.astro — the static 404 page (immersive direction).
 *
 * Frozen references: DEPLOYMENT_ARCHITECTURE §7 + BUILD_AND_ROUTING §4 route
 * table (static 404 at 404.html; Nginx `try_files $uri $uri/ =404`; NO SPA
 * fallback), §5.5 (one h1). Visual system: canvas + text only — no imagery,
 * no SVG. The serif title, a mono note and the one outlined action carry the
 * reader back to the cover.
 */
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <div class="notfound-page">
    <h1 class="notfound-title">Page not found</h1>
    <p class="notfound-note mono-label">No photograph at this address</p>
    <a class="action notfound-action" href="/">Return to the cover</a>
  </div>
</Base>

<style>
  .notfound-page {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--edge-inset);
    padding-block: var(--space-4xl) var(--space-6xl);
  }

  .notfound-title {
    margin: 0;
    font-family: var(--type-h1-family);
    font-size: var(--type-h1-size);
    font-weight: var(--type-h1-weight);
    line-height: var(--type-h1-lh);
    letter-spacing: var(--type-h1-tracking);
    color: var(--color-text-primary);
  }

  .notfound-note {
    margin: var(--space-md) 0 0;
  }

  .notfound-action {
    margin-top: var(--space-xl);
  }
</style>
