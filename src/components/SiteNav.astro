---
/*
 * src/components/SiteNav.astro — frozen top navigation (immersive skin).
 *
 * Strategy: baseline visible/in-flow links (RUNTIME_AND_PROGRESSIVE_ENHANCEMENT
 * §7.3 "Baseline visible/in-flow navigation links") — a single responsive
 * <ul> of native <a> anchors that works with NO JavaScript. The NAV items are
 * exactly the frozen top-level IA: Journeys, Places, About (FDS §1.3; the
 * label renamed Archive → Journeys at go-live, 2026-09-12 — the page,
 * its metadata and the back-origin controls all use "Journeys"). The
 * site mark (→ Home) lives in the header, outside this <nav> landmark.
 *
 * Current destination (frozen contract, pinned by tests/e2e/nav-current.spec.ts
 * "quiet underline"): Astro.url.pathname is the build-time current route; the
 * matching anchor gets aria-current="page" + the quiet underline. Build-time
 * static — no JS. Immersive pass: the label speaks the interface voice at a
 * regular weight and a slightly opened tracking; the marker, the labels and
 * the 44px targets are unchanged.
 *
 * No-JS contract (§7.1–§7.4): no checkbox-hack, no display:none-only toggle,
 * no JS-gated links. Touch targets ≥44px (visual redesign spec §5).
 * No persistent app chrome (§4.2). JS may enhance later but never gates.
 */

interface Item {
  label: string;
  href: string;
}

const items: Item[] = [
  { label: "Journeys", href: "/archive" },
  { label: "Places", href: "/places" },
  { label: "About", href: "/about" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav class="site-nav" aria-label="Primary">
  <ul>
    {items.map((item) => (
      <li>
        <a
          class:list={["nav-link", { "is-current": isCurrent(item.href) }]}
          href={item.href}
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-lg); /* visual redesign spec §5: 32px desktop nav gap */
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav li {
    margin: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* visual redesign spec §5 touch-target floor */
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--type-nav-size-min);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: var(--type-nav-lh);
    padding-block: 12px;
    transition: color var(--dur-micro) var(--ease-out-editorial);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  /* Frozen current-destination treatment (stage3a): quiet underline. */
  .nav-link.is-current {
    text-decoration: underline;
    text-underline-offset: 5px;
    color: var(--color-text-primary);
  }

  /*
   * Content-fit: when the row can't keep comfortable gaps on narrow
   * screens the items wrap naturally (flex-wrap), never overflowing. The
   * 900px boundary aligns with the tokens.css magnitude switch.
   */
  @media (max-width: 899px) {
    .site-nav ul {
      gap: 0 clamp(16px, 6vw, 40px); /* tighter, still ≥ readable separation */
    }
  }

  /* Narrow phones: the three links must share the row with the three theme
     chips, or the bar wraps to three rows and the opening cover loses the
     first screen. Compact density, 44px targets kept. */
  @media (max-width: 480px) {
    .site-nav ul {
      gap: 0 12px;
    }

    .nav-link {
      font-size: 12.5px;
      letter-spacing: 0.02em;
      padding-block: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link {
      transition: none;
    }
  }
</style>