---
/*
 * src/components/PlaceAtlasCard.astro — one place on the atlas index
 * (immersive direction).
 *
 * A representative cover + the place name in the serif voice with its
 * disambiguation context as a mono line. NO counts (CONTENT_MODEL §6.3). The
 * photograph is shown whole (never cropped, never framed): the stage is a
 * fixed-height track the picture is anchored to at bottom-left, carrying only
 * the project's edge treatment. The image is decorative (the place name is the
 * link text), so alt="".
 */
import type { PlacesViewEntry } from "../lib/views/places";

interface Props {
  place: PlacesViewEntry;
}

const { place } = Astro.props;
const context = [place.region, place.country].filter(Boolean).join(", ");
const ATLAS_SIZES = "(min-width: 900px) 27vw, 90vw";
---

<li class="place-atlas-item">
  <a class="place-atlas-card" href={`/places/${place.slug}`}>
    {
      place.cover && place.cover.src !== "" && (
        <span class="place-atlas-stage">
          <picture>
            {place.cover.avifSrcset && (
              <source type="image/avif" srcset={place.cover.avifSrcset} sizes={ATLAS_SIZES} />
            )}
            <img
              class="place-atlas-img"
              src={place.cover.src}
              srcset={place.cover.srcset}
              sizes={ATLAS_SIZES}
              width={place.cover.width}
              height={place.cover.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </picture>
        </span>
      )
    }
    <span class="place-atlas-text">
      <span class="place-atlas-name">{place.name}</span>
      {context && <span class="place-atlas-context mono-meta">{context}</span>}
    </span>
  </a>
</li>

<style>
  .place-atlas-item {
    list-style: none;
  }

  .place-atlas-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* The stage: a fixed-height track so the atlas keeps one rhythm; the
     photograph hugs its own ratio inside it. */
  .place-atlas-stage {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    height: clamp(180px, 18vw, 240px);
    margin-bottom: var(--space-md);
  }

  .place-atlas-stage picture {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    max-height: 100%;
  }

  .place-atlas-img {
    /* Never distort: the stage is fixed-height, so a cover that is not 3:2
       letterboxes against the field instead of stretching. */
    object-fit: contain;
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    box-shadow: var(--photo-edge), var(--photo-shadow-sm);
    transition: box-shadow var(--dur-medium) var(--ease-out-editorial);
  }

  .place-atlas-card:hover .place-atlas-img,
  .place-atlas-card:focus-visible .place-atlas-img {
    box-shadow: var(--photo-edge), var(--photo-shadow-lift);
  }

  .place-atlas-text {
    display: block;
  }

  .place-atlas-name {
    display: block;
    font-family: var(--type-card-title-family, var(--font-serif));
    font-size: var(--type-card-title-size);
    font-weight: var(--type-card-title-weight);
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .place-atlas-card:hover .place-atlas-name,
  .place-atlas-card:focus-visible .place-atlas-name {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .place-atlas-context {
    display: block;
    margin-top: var(--space-2xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .place-atlas-img {
      transition: none;
    }
  }
</style>
