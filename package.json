{
  "name": "quiet-editorial-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quiet Editorial Archive - Astro static photography site (production).",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "astro": "astro",
    "check": "astro check && eslint .",
    "dev": "astro dev",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:preview": "node tests/support/preview-e2e.mjs",
    "test:a11y": "playwright test --project=a11y",
    "validate:runtime": "node scripts/validate/runtime.mjs",
    "test:regression": "node scripts/verify/implementation-regression.mjs",
    "validate:content": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/validate/content.ts --mode production",
    "validate:dry-run": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/validate/dry-run.ts",
    "media:discover": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/media/discover.ts",
    "media:extract": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/media/extract.ts",
    "validate:sources": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/media/validate-sources.ts --mode production",
    "media:derive": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/media/derive.ts media/ingest-masters --out generated/media --concurrency 4",
    "media:privacy-check": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/media/privacy-check.ts generated/media",
    "media:manifest": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/media/manifest.ts",
    "media:exif": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/media/exif-sidecar.ts",
    "media:atmosphere": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/media/atmosphere.ts",
    "media:pipeline": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/media/pipeline.ts",
    "media:coverage": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/media/coverage.ts",
    "media:preview": "node scripts/media/preview-media.mjs",
    "media:verify": "node --experimental-strip-types --import ./scripts/validate/register-ts-resolve.mjs scripts/media/pipeline.ts",
    "bench:smoke": "node --experimental-strip-types scripts/bench/run-smoke.ts",
    "bench:wp16:fixtures": "node --experimental-strip-types scripts/bench/icc/make-fixtures.ts",
    "bench:wp16:measure": "node --experimental-strip-types scripts/bench/icc/measure.ts",
    "bench:wp15": "node --experimental-strip-types scripts/bench/campaigns/wp15-run.ts --run 1 && node --experimental-strip-types scripts/bench/campaigns/wp15-run.ts --run 2 && node --experimental-strip-types scripts/bench/campaigns/wp15-aggregate.ts",
    "bench:wp15:crops": "node --experimental-strip-types scripts/bench/campaigns/wp15-crops.ts",
    "bench:wp15:addendum": "node --experimental-strip-types scripts/bench/campaigns/wp15-addendum.ts",
    "bench:wp15:addendum:render": "node --experimental-strip-types scripts/bench/campaigns/wp15-addendum-render.ts",
    "build": "node scripts/validate/qa-build-guard.mjs && ASTRO_PRODUCTION_VALIDATE=1 astro build",
    "build:media": "npm run media:pipeline && npm run build",
    "build:preview": "ASTRO_PREVIEW_MODE=1 astro build",
    "build:qa": "QA_PROBE=1 astro build",
    "capture": "node tests/capture/capture.mjs",
    "capture:diff": "node tests/capture/diff.mjs",
    "capture:determinism": "node tests/capture/determinism.mjs",
    "perf:measure": "node --experimental-strip-types scripts/perf/measure.mjs",
    "perf:validate": "node --experimental-strip-types scripts/perf/validate-baseline.mjs",
    "baseline:update": "node tests/capture/baseline-update.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "js-yaml": "5.4.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
